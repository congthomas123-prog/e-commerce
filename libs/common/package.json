{
  "name": "@org/common",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "common",
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsc --build tsconfig.lib.json --emitDeclarationOnly",
          "cwd": "libs/common"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "jest --config jest.config.js",
          "cwd": "libs/common"
        }
      }
    }
  },
  "dependencies": {}
}
