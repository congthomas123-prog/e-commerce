generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id          String      @id
  customerId  String
  status      OrderStatus
  currency    String
  totalAmount Int
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id              String @id
  orderId         String
  productId       String
  sku             String
  name            String
  unitPriceAmount Int
  quantity        Int
  lineTotalAmount Int
  order           Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  CANCELLED
}
